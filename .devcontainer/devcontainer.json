{
  "name": "Career Fit Agent v1.8",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "Career Fit Agent",
      "onAutoForward": "openBrowser",
      "protocol": "http"
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "remoteEnv": {
    "CFA_RUNTIME_MODE": "selfhost",
    "CFA_SEED_DEMO": "0",
    "CFA_DATA_DIR": "${containerWorkspaceFolder}/data",
    "CFA_WEB_ROOT": "${containerWorkspaceFolder}",
    "PYTHONPATH": "${containerWorkspaceFolder}/backend"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}