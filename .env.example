# Aggregators
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
JOOBLE_ENDPOINT=https://jooble.org/api

# Direct ATS boards to monitor (comma-separated board/site identifiers)
ASHBY_BOARDS=
LEVER_SITES=
GREENHOUSE_BOARDS=

# Optional future model providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_MINI_APP_URL=https://your-domain.example/miniapp/
CAREER_FIT_API_URL=https://your-domain.example/api


# Runtime split
CFA_RUNTIME_MODE=selfhost
CFA_GITHUB_URL=https://github.com/dokarpov/career-fit-agent

# Managed Telegram
CFA_INTERNAL_BOT_SECRET=
CFA_MANAGED_CYCLE_STARS=2499
CFA_MANAGED_CYCLE_DAYS=90
CFA_TOKEN_ENCRYPTION_KEY=

# Google OAuth (managed or self-host)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=https://your-domain.example/oauth/google/callback

# Free self-host providers
OLLAMA_BASE_URL=http://host.docker.internal:11434
GITHUB_TOKEN=


# Public URLs / Gmail push
CFA_PUBLIC_BASE_URL=https://your-domain.example
GMAIL_PUBSUB_TOPIC=projects/your-project/topics/career-fit-gmail
GMAIL_PUBSUB_WEBHOOK_TOKEN=
GMAIL_FALLBACK_SYNC_SECONDS=21600
CFA_WORKER_TICK_SECONDS=30

# Local demo fixtures only. Keep 0 in real user deployments.
CFA_SEED_DEMO=0

# Autopilot search / discovery
CFA_AUTOPILOT_SEARCH_MINUTES=360
CFA_SEARCH_COUNTRIES=es,de,fr,nl,pt,ie,gb
WORKABLE_ACCOUNTS=
SMARTRECRUITERS_COMPANIES=
CAREER_SITE_URLS=
VC_PORTFOLIO_JOB_URLS=

# Managed GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=https://your-domain.example/oauth/github/callback

# Optional managed defaults for one-time hard constraints
CFA_DEFAULT_REMOTE_ONLY=0
CFA_DEFAULT_ALLOW_RELOCATION=1
CFA_DEFAULT_SALARY_FLOOR=0
CFA_DEFAULT_HOME_REGION=
CFA_DEFAULT_ALLOWED_REGIONS=
CFA_DEFAULT_EXCLUDED_ROLE_TERMS=
CFA_DEFAULT_EXCLUDED_DOMAINS=
