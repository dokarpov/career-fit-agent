{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CandidatePreferences",
  "type": "object",
  "properties": {
    "remoteOnly": {
      "type": "boolean"
    },
    "allowRelocation": {
      "type": "boolean"
    },
    "salaryFloorAnnual": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "type": "string"
    },
    "minRoleInterest": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "minDomainAppetite": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "maxApplicationMinutes": {
      "type": "number",
      "minimum": 1
    }
  }
}